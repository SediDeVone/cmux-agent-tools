#!/usr/bin/env bash
# cmux-md — open markdown files in cmux with sane pane management.
#
#   * one dedicated "docs" pane per workspace (markdown tabs never mix with terminals)
#   * never opens the same file twice — reuses the existing tab
#   * always targets the calling agent's own workspace ($CMUX_WORKSPACE_ID)
#
# Usage:
#   cmux-md <path> [--focus true|false] [--direction left|right|up|down]
#   cmux-md tidy      move stray markdown tabs into a dedicated docs pane
#   cmux-md list      show markdown tabs for this workspace
#   cmux-md prune     drop registry entries for tabs that no longer exist
#
# cmux CLI quirks this works around (verified 2026-09-15):
#   - `split-off --surface` does NOT resolve UUIDs; it needs a surface:N ref,
#     and silently falls back to the focused surface otherwise.
#   - `move-surface` prints OK/Error unreliably — verify via the tree, not $?.
#   - tree reads are stale right after a mutation; `refresh-surfaces` settles them.
#
# Exit codes: 0 ok (opened or already open), 1 error, 2 cmux unavailable.

set -uo pipefail

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cmux-md"

die() { printf 'cmux-md: %s\n' "$*" >&2; exit 1; }

command -v cmux >/dev/null 2>&1 || { printf 'cmux-md: cmux not found; skipping\n' >&2; exit 2; }
if [ -z "${CMUX_SOCKET_PATH:-}" ] && [ -z "${CMUX_WORKSPACE_ID:-}" ]; then
  cmux ping >/dev/null 2>&1 || { printf 'cmux-md: not inside a cmux session; skipping\n' >&2; exit 2; }
fi

refresh() { cmux refresh-surfaces >/dev/null 2>&1 || true; }

resolve_ws() {
  if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then printf '%s' "$CMUX_WORKSPACE_ID"; return 0; fi
  local w; w="$(cmux current-workspace 2>/dev/null | tr -d '[:space:]')"
  [ -n "$w" ] || return 1
  printf '%s' "$w"
}

# emits: paneUUID \t paneRef \t surfUUID \t surfRef \t type \t title
tree_surfaces() {
  local ws="$1"
  cmux --id-format both tree --workspace "$ws" 2>/dev/null | awk '
    {
      pane_i = 0; surf_i = 0
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^pane:[0-9]+$/)    pane_i = i
        if ($i ~ /^surface:[0-9]+$/) surf_i = i
      }
      if (pane_i > 0 && surf_i == 0) { pane_ref = $pane_i; pane_uuid = $(pane_i + 1); next }
      if (surf_i > 0 && pane_uuid != "") {
        surf_ref  = $surf_i
        surf_uuid = $(surf_i + 1)
        type = $(surf_i + 2); gsub(/[\[\]]/, "", type)
        title = ""
        q1 = index($0, "\"")
        if (q1 > 0) { rest = substr($0, q1 + 1); q2 = index(rest, "\""); if (q2 > 1) title = substr(rest, 1, q2 - 1) }
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", pane_uuid, pane_ref, surf_uuid, surf_ref, type, title
      }
    }'
}

reg_file() { printf '%s/%s.tsv' "$STATE_DIR" "$1"; }

prune_registry() {
  local ws="$1" reg live tmp
  reg="$(reg_file "$ws")"; [ -f "$reg" ] || return 0
  live="$(tree_surfaces "$ws" | awk -F'\t' '$5=="markdown"{print $3}')"
  tmp="$(mktemp)"
  while IFS=$'\t' read -r sid path; do
    [ -n "${sid:-}" ] || continue
    printf '%s\n' "$live" | grep -qxF "$sid" && printf '%s\t%s\n' "$sid" "$path" >> "$tmp"
  done < "$reg"
  mv "$tmp" "$reg"
}

lookup_surface() {
  local reg; reg="$(reg_file "$1")"
  [ -f "$reg" ] && awk -F'\t' -v p="$2" '$2==p{print $1; exit}' "$reg"
}

# Display label: "<parent>/<basename>" so two README.md files never collide.
label_for() {
  local abs="$1" parent
  parent="$(basename "$(dirname "$abs")")"
  printf '%s/%s' "$parent" "$(basename "$abs")"
}

# Title-based fallback for tabs we did not open ourselves.
# Never matches a surface the registry already binds to a DIFFERENT path —
# that is how a bare "README.md" tab used to hijack every other README.
lookup_by_title() {  # $1 ws  $3 label  $4 abs   ($2 kept for call-site symmetry)
  local reg; reg="$(reg_file "$1")"
  tree_surfaces "$1" | awk -F'\t' -v l="$3" -v reg="$reg" -v abs="$4" '
    BEGIN { if (reg != "") while ((getline line < reg) > 0) { split(line, a, "\t"); owner[a[1]] = a[2] } }
    $5=="markdown" && $6==l {
      if (($3 in owner) && owner[$3] != abs) next
      print $3; exit
    }'
}

field_of_surface() {  # $1 ws  $2 surfUUID  $3 field-index
  tree_surfaces "$1" | awk -F'\t' -v s="$2" -v f="$3" '$3==s{print $f; exit}'
}

# Pane whose surfaces are ALL markdown; most tabs wins.
docs_pane() {
  tree_surfaces "$1" | awk -F'\t' '
    { total[$1]++; if ($5 == "markdown") md[$1]++ }
    END { best=""; n=0; for (p in total) if (total[p]==md[p] && md[p]>n) { best=p; n=md[p] }
          if (best != "") print best }'
}

register() {
  local ws="$1" sid="$2" path="$3" reg tmp
  mkdir -p "$STATE_DIR"; reg="$(reg_file "$ws")"; touch "$reg"
  tmp="$(mktemp)"
  awk -F'\t' -v s="$sid" -v p="$path" '$1!=s && $2!=p' "$reg" > "$tmp" 2>/dev/null || true
  printf '%s\t%s\n' "$sid" "$path" >> "$tmp"
  mv "$tmp" "$reg"
}

# Ensure a markdown-only pane exists; echo its UUID.
ensure_docs_pane() {
  local ws="$1" target first_ref first_uuid
  target="$(docs_pane "$ws")"
  [ -n "$target" ] && { printf '%s' "$target"; return 0; }

  first_uuid="$(tree_surfaces "$ws" | awk -F'\t' '$5=="markdown"{print $3; exit}')"
  first_ref="$(tree_surfaces  "$ws" | awk -F'\t' '$5=="markdown"{print $4; exit}')"
  [ -n "$first_ref" ] || return 1

  # split-off needs the REF, not the UUID, and a --workspace context.
  cmux split-off --workspace "$ws" --surface "$first_ref" right >/dev/null 2>&1 || true
  refresh
  target="$(field_of_surface "$ws" "$first_uuid" 1)"
  [ -n "$target" ] || return 1
  printf '%s' "$target"
}

cmd_list() {
  local ws; ws="$(resolve_ws)" || die "cannot resolve workspace"
  prune_registry "$ws"
  printf 'workspace %s\n' "$ws"
  printf 'docs pane  %s\n' "$(docs_pane "$ws" || echo '<none>')"
  tree_surfaces "$ws" | awk -F'\t' '$5=="markdown"{printf "  %-12s %s\n", $4, $6}'
}

cmd_prune() {
  local ws; ws="$(resolve_ws)" || die "cannot resolve workspace"
  prune_registry "$ws"; printf 'cmux-md: registry pruned\n'
}

cmd_tidy() {
  local ws target moved=0
  ws="$(resolve_ws)" || die "cannot resolve workspace"
  tree_surfaces "$ws" | awk -F'\t' '$5=="markdown"' | grep -q . \
    || { printf 'cmux-md: no markdown tabs to tidy\n'; return 0; }

  target="$(ensure_docs_pane "$ws")" || die "could not create a docs pane"

  while IFS=$'\t' read -r pane pref sid sref type title; do
    [ "$type" = "markdown" ] || continue
    [ "$pane" != "$target" ] || continue
    cmux move-surface --workspace "$ws" --surface "$sid" --pane "$target" >/dev/null 2>&1 || true
    refresh
    if [ "$(field_of_surface "$ws" "$sid" 1)" = "$target" ]; then
      moved=$((moved + 1)); printf 'cmux-md: moved %s\n' "$title"
    fi
  done < <(tree_surfaces "$ws")

  printf 'cmux-md: docs pane %s (%d moved)\n' "$target" "$moved"
}

cmd_open() {
  local path="$1" focus="$2" direction="$3"
  [ -e "$path" ] || die "no such file: $path"
  local abs base label ws existing target out sid uuid cur
  abs="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
  base="$(basename "$abs")"
  label="$(label_for "$abs")"
  ws="$(resolve_ws)" || die "cannot resolve workspace"

  prune_registry "$ws"

  existing="$(lookup_surface "$ws" "$abs")"
  if [ -n "$existing" ]; then
    # Registry match is keyed on the absolute path, so relabelling is safe.
    cur="$(field_of_surface "$ws" "$existing" 4)"
    [ -n "$cur" ] && cmux rename-tab --workspace "$ws" --surface "$cur" "$label" >/dev/null 2>&1
  else
    existing="$(lookup_by_title "$ws" "$base" "$label" "$abs")"
  fi
  if [ -n "$existing" ]; then
    register "$ws" "$existing" "$abs"
    if [ "$focus" = "true" ]; then
      cur="$(field_of_surface "$ws" "$existing" 2)"
      [ -n "$cur" ] && cmux focus-pane --workspace "$ws" --pane "$cur" >/dev/null 2>&1
    fi
    printf 'cmux-md: already open — %s\n' "$label"
    return 0
  fi

  target="$(docs_pane "$ws")"

  out="$(cmux markdown open "$abs" --workspace "$ws" --focus "$focus" --direction "$direction" 2>&1)" \
    || die "cmux markdown failed: $out"
  refresh

  # Resolve the surface ref cmux just returned to a stable UUID. Matching on title
  # would fail here: a freshly opened tab still carries the bare basename.
  local newref
  newref="$(printf '%s' "$out" | sed -n 's/.*surface=\([^ ]*\).*/\1/p')"
  sid=""
  [ -n "$newref" ] && sid="$(tree_surfaces "$ws" | awk -F'\t' -v r="$newref" '$4==r{print $3; exit}')"
  [ -n "$sid" ] || sid="$(lookup_by_title "$ws" "$base" "$label" "$abs")"

  # Disambiguate the tab title so basename collisions cannot false-match later.
  if [ -n "$sid" ]; then
    cur="$(field_of_surface "$ws" "$sid" 4)"
    [ -n "$cur" ] && cmux rename-tab --workspace "$ws" --surface "$cur" "$label" >/dev/null 2>&1
    refresh
  fi

  if [ -n "$target" ] && [ -n "$sid" ]; then
    cur="$(field_of_surface "$ws" "$sid" 1)"
    if [ -n "$cur" ] && [ "$cur" != "$target" ]; then
      cmux move-surface --workspace "$ws" --surface "$sid" --pane "$target" >/dev/null 2>&1 || true
      refresh
    fi
  fi

  [ -n "$sid" ] && register "$ws" "$sid" "$abs"
  printf 'cmux-md: opened %s\n' "$label"
}

[ $# -gt 0 ] || die "usage: cmux-md <path> [--focus true|false] [--direction dir] | tidy | list | prune"
case "$1" in
  tidy)  cmd_tidy;  exit $? ;;
  list)  cmd_list;  exit $? ;;
  prune) cmd_prune; exit $? ;;
esac

FOCUS="false"; DIRECTION="right"; TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --focus)     FOCUS="${2:-false}"; shift 2 ;;
    --direction) DIRECTION="${2:-right}"; shift 2 ;;
    open)        shift ;;
    -*)          shift ;;
    *)           [ -z "$TARGET" ] && TARGET="$1"; shift ;;
  esac
done
[ -n "$TARGET" ] || die "no path given"
cmd_open "$TARGET" "$FOCUS" "$DIRECTION"
